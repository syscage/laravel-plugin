{
    "name": "syscage/laravel-plugin",
    "description": "A WordPress-style plugin framework for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "homepage": "https://github.com/syscage/laravel-plugin",
    "keywords": [
        "laravel",
        "plugin",
        "plugins",
        "modules",
        "framework"
    ],
    "authors": [
        {
            "name": "Syscage",
            "homepage": "https://syscage.com",
            "email": "contact@syscage.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer/semver": "^3.4",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Syscage\\Plugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Syscage\\Plugin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Syscage\\Plugin\\PluginServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
